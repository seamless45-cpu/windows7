{
  "name": "windows7-desktop",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "PAGES_BASE_PATH=/windows7 next build && node scripts/publish-pages.mjs && node scripts/verify-publish.mjs",
    "start": "npx serve@14 out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:softkb": "node --experimental-strip-types --no-warnings tests/softkeyboard.test.mjs",
    "verify:pages": "node scripts/verify-publish.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^25.0.1",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
